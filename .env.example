# ── Application ──────────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8080
APP_NAME=ShikaGari

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=shikagari_user
DB_PASSWORD=your_secure_password
DB_NAME=shikagari_db
DB_SSLMODE=disable            # use 'require' in production

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRY_HOURS=72           # Token validity in hours

# ── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads          # Local storage path (swap for S3 in production)
MAX_FILE_SIZE_MB=5